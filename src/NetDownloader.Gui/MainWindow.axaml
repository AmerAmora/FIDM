<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NetDownloader.Gui.ViewModels"
        xmlns:views="using:NetDownloader.Gui.Views"
        x:Class="NetDownloader.Gui.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="NetDownloader"
        Width="1240" Height="780"
        MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#0D1119">

    <Grid ColumnDefinitions="236,*">
        <!-- =============================================================== -->
        <!-- 1. LEFT NAVIGATION & TELEMETRY SIDEBAR                          -->
        <!-- =============================================================== -->
        <Border Grid.Column="0" Background="#090C12" BorderBrush="#182030" BorderThickness="0,0,1,0" Padding="16,18,16,16">
            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <!-- Brand Identity + CNL Port Pill -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="2,0,2,18">
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                            Background="{StaticResource PrimaryGradientBrush}"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                        <Path Data="M 13,3 L 6,13 L 11,13 L 10,21 L 18,10 L 13,10 Z"
                              Fill="#FFFFFF" Width="16" Height="16" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="NetDownloader" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ServerPortText}" FontSize="11" FontWeight="Medium" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Quick Capture Primary CTA -->
                <Button Grid.Row="1" Classes="primary" Command="{Binding AddUrlsCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Margin="0,0,0,22" Padding="14,10">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Path Data="M 12,5 L 12,19 M 5,12 L 19,12" Stroke="#FFFFFF" StrokeThickness="2.2"
                              StrokeLineCap="Round" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Add Download Links" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Navigation Menu -->
                <StackPanel Grid.Row="2" Spacing="4">
                    <TextBlock Text="WORKSPACE" FontSize="10.5" FontWeight="Bold" Foreground="#475569"
                               LetterSpacing="1" Margin="10,0,0,6"/>

                    <!-- Downloads -->
                    <Button Classes="nav" Command="{Binding NavigateCommand}" CommandParameter="Downloads"
                            Background="{Binding DownloadsNavBackground}">
                        <Grid ColumnDefinitions="3,22,*,Auto">
                            <Border Grid.Column="0" Width="3" Height="18" CornerRadius="1.5"
                                    Background="#3B82F6" IsVisible="{Binding DownloadsIndicatorVisible}"/>
                            <Path Grid.Column="1" Data="M 12,3 L 12,15 M 7,10 L 12,15 L 17,10 M 5,20 L 19,20"
                                  Stroke="#38BDF8" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                                  Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="4,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="Downloads" Foreground="{Binding DownloadsNavForeground}"
                                       FontWeight="Medium" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <Border Grid.Column="3" Background="#162032" BorderBrush="#23324D" BorderThickness="1"
                                    CornerRadius="10" Padding="7,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AllPackagesCount}" FontSize="11" FontWeight="SemiBold" Foreground="#93C5FD"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- LinkGrabber -->
                    <Button Classes="nav" Command="{Binding NavigateCommand}" CommandParameter="LinkGrabber"
                            Background="{Binding LinkGrabberNavBackground}">
                        <Grid ColumnDefinitions="3,22,*,Auto">
                            <Border Grid.Column="0" Width="3" Height="18" CornerRadius="1.5"
                                    Background="#3B82F6" IsVisible="{Binding LinkGrabberIndicatorVisible}"/>
                            <Path Grid.Column="1" Data="M 10,13 A 5,5 0 0 0 17.54,13.54 L 20.54,10.54 A 5,5 0 0 0 13.47,3.47 L 11.75,5.18 M 14,11 A 5,5 0 0 0 6.46,10.46 L 3.46,13.46 A 5,5 0 0 0 10.53,20.53 L 12.24,18.82"
                                  Stroke="#60A5FA" StrokeThickness="1.8" StrokeLineCap="Round"
                                  Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="4,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="LinkGrabber" Foreground="{Binding LinkGrabberNavForeground}"
                                       FontWeight="Medium" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </Button>

                    <!-- Completed -->
                    <Button Classes="nav" Command="{Binding NavigateCommand}" CommandParameter="Completed"
                            Background="{Binding CompletedNavBackground}">
                        <Grid ColumnDefinitions="3,22,*,Auto">
                            <Border Grid.Column="0" Width="3" Height="18" CornerRadius="1.5"
                                    Background="#3B82F6" IsVisible="{Binding CompletedIndicatorVisible}"/>
                            <Path Grid.Column="1" Data="M 20,6 L 9,17 L 4,12"
                                  Stroke="#10B981" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                  Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="4,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="Completed" Foreground="{Binding CompletedNavForeground}"
                                       FontWeight="Medium" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <Border Grid.Column="3" Background="#122923" BorderBrush="#1F473B" BorderThickness="1"
                                    CornerRadius="10" Padding="7,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CompletedCount}" FontSize="11" FontWeight="SemiBold" Foreground="#34D399"/>
                            </Border>
                        </Grid>
                    </Button>

                    <TextBlock Text="SYSTEM" FontSize="10.5" FontWeight="Bold" Foreground="#475569"
                               LetterSpacing="1" Margin="10,18,0,6"/>

                    <!-- Settings -->
                    <Button Classes="nav" Command="{Binding NavigateCommand}" CommandParameter="Settings"
                            Background="{Binding SettingsNavBackground}">
                        <Grid ColumnDefinitions="3,22,*">
                            <Border Grid.Column="0" Width="3" Height="18" CornerRadius="1.5"
                                    Background="#3B82F6" IsVisible="{Binding SettingsIndicatorVisible}"/>
                            <Path Grid.Column="1" Data="M 4,21 L 4,14 M 4,10 L 4,3 M 12,21 L 12,12 M 12,8 L 12,3 M 20,21 L 20,16 M 20,12 L 20,3 M 1,14 L 7,14 M 9,8 L 15,8 M 17,16 L 23,16"
                                  Stroke="#94A3B8" StrokeThickness="1.8" StrokeLineCap="Round"
                                  Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="4,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="Engine Settings" Foreground="{Binding SettingsNavForeground}"
                                       FontWeight="Medium" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Bottom Docked Live Speed & Bandwidth Limiter Card -->
                <Border Grid.Row="3" Background="#0E131D" BorderBrush="#1B2538" BorderThickness="1"
                        CornerRadius="12" Padding="13,12">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="LIVE THROUGHPUT" FontSize="10" FontWeight="Bold" Foreground="#64748B" LetterSpacing="0.6"/>
                                <TextBlock Text="{Binding AggregateSpeedText}" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8" Background="#132238" VerticalAlignment="Top">
                                <Path Data="M 13,2 L 3,14 L 12,14 L 11,22 L 21,10 L 12,10 Z"
                                      Fill="#38BDF8" Width="14" Height="14" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding ActiveTasksText}" FontSize="11.5" Foreground="#94A3B8"/>

                        <Border Height="1" Background="#192233"/>

                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="Cap (MB/s)" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Value="{Binding SpeedLimitValueMb}" Minimum="1" Maximum="1000"
                                           Width="88" Height="28" CornerRadius="6"
                                           Background="#090C12" BorderBrush="#222E45" Foreground="#F8FAFC" FontSize="12"
                                           VerticalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- =============================================================== -->
        <!-- 2. RIGHT MAIN WORKSPACE (TOP COMMAND BAR + VIEWPORT)            -->
        <!-- =============================================================== -->
        <Grid Grid.Column="1" RowDefinitions="58,*">
            <!-- Unified Top Command Bar -->
            <Border Grid.Row="0" Background="#0B0F17" BorderBrush="#182030" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Transport Action Controls -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="toolbar" Command="{Binding StartAllCommand}" ToolTip.Tip="Start or resume all queued packages">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Data="M 6,4 L 20,12 L 6,20 Z" Fill="#10B981" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="Start All" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Classes="toolbar" Command="{Binding PauseAllCommand}" ToolTip.Tip="Pause all active downloads">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Data="M 6,4 L 10,4 L 10,20 L 6,20 Z M 14,4 L 18,4 L 18,20 L 14,20 Z" Fill="#F59E0B" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="Pause All" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Classes="toolbar" Command="{Binding StopAllCommand}" ToolTip.Tip="Stop active transfers">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Data="M 5,5 L 19,5 L 19,19 L 5,19 Z" Fill="#EF4444" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="Stop" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right: Search Filter + Clipboard Auto-Monitor -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <!-- Search Input -->
                        <Grid VerticalAlignment="Center">
                            <TextBox Classes="modern" Text="{Binding SearchFilter}"
                                     Width="250" Height="34"
                                     FontSize="12.5" Padding="32,6,10,6"
                                     Watermark="Filter packages or files..."
                                     VerticalContentAlignment="Center"/>
                            <Path Data="M 11,4 A 7,7 0 1 0 11,18 A 7,7 0 1 0 11,4 M 20,20 L 16.5,16.5"
                                  Stroke="#64748B" StrokeThickness="1.8" StrokeLineCap="Round"
                                  Width="13" Height="13" Stretch="Uniform"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0"
                                  IsHitTestVisible="False"/>
                        </Grid>

                        <!-- Clipboard Monitor Pill -->
                        <Border Background="#121824" BorderBrush="#1E2738" BorderThickness="1"
                                CornerRadius="8" Padding="11,3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Path Data="M 9,2 L 15,2 L 15,5 L 9,5 Z M 16,4 L 18,4 A 2,2 0 0 1 20,6 L 20,20 A 2,2 0 0 1 18,22 L 6,22 A 2,2 0 0 1 4,20 L 4,6 A 2,2 0 0 1 6,4 L 8,4"
                                      Stroke="#60A5FA" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                      Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="Clipboard Monitor" Foreground="#CBD5E1" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                <ToggleSwitch IsChecked="{Binding IsClipboardMonitorEnabled}" OnContent="" OffContent=""
                                              Margin="0,-4,0,-4" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic Page Viewport -->
            <Border Grid.Row="1" Background="#0D1119" Padding="26,22">
                <Panel>
                    <views:DownloadsView IsVisible="{Binding IsDownloadsView}"/>

                    <views:LinkGrabberView DataContext="{Binding LinkGrabberVm}"
                                           IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsLinkGrabberView}"/>

                    <views:CompletedView IsVisible="{Binding IsCompletedView}"/>

                    <views:SettingsView DataContext="{Binding SettingsVm}"
                                        IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSettingsView}"/>
                </Panel>
            </Border>
        </Grid>
    </Grid>
</Window>
