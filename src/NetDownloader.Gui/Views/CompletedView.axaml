<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetDownloader.Gui.ViewModels"
             x:Class="NetDownloader.Gui.Views.CompletedView"
             x:DataType="vm:MainWindowViewModel">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- 1. Header + Clear Completed -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
            <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Text="Completed Downloads" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock Text="Finished &amp; extracted packages saved on disk" FontSize="12.5" Foreground="#64748B"/>
            </StackPanel>

            <Button Grid.Column="1" Classes="toolbar" Command="{Binding ClearCompletedCommand}"
                    IsVisible="{Binding HasCompletedPackages}" VerticalAlignment="Center" Padding="13,7">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Path Data="M 3,6 L 21,6 M 8,6 L 8,4 A 2,2 0 0 1 10,2 L 14,2 A 2,2 0 0 1 16,4 L 16,6 M 19,6 L 19,20 A 2,2 0 0 1 17,22 L 7,22 A 2,2 0 0 1 5,20 L 5,6"
                          Stroke="#94A3B8" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Text="Clear History" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 2. Column Header -->
        <Border Grid.Row="1" Background="#101520" BorderBrush="#1B2436" BorderThickness="1"
                CornerRadius="8" Padding="14,9" Margin="0,0,0,10"
                IsVisible="{Binding HasCompletedPackages}">
            <Grid ColumnDefinitions="*,110,115,80">
                <TextBlock Grid.Column="0" Text="PACKAGE &amp; LOCATION" Foreground="#64748B" FontWeight="Bold" FontSize="11" LetterSpacing="0.6"/>
                <TextBlock Grid.Column="1" Text="SIZE" Foreground="#64748B" FontWeight="Bold" FontSize="11" LetterSpacing="0.6" TextAlignment="Right" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="2" Text="STATUS" Foreground="#64748B" FontWeight="Bold" FontSize="11" LetterSpacing="0.6" TextAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="ACTIONS" Foreground="#64748B" FontWeight="Bold" FontSize="11" LetterSpacing="0.6" TextAlignment="Right" Margin="0,0,4,0"/>
            </Grid>
        </Border>

        <!-- 3A. Empty State -->
        <Border Grid.Row="2" IsVisible="{Binding !HasCompletedPackages}"
                Background="#101520" BorderBrush="#1B2436" BorderThickness="1"
                CornerRadius="14" Padding="42,48"
                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
            <StackPanel Spacing="12" HorizontalAlignment="Center">
                <Border Width="52" Height="52" CornerRadius="15" Background="#102921" BorderBrush="#1C4A3B" BorderThickness="1"
                        HorizontalAlignment="Center">
                    <Path Data="M 20,6 L 9,17 L 4,12" Stroke="#10B981" StrokeThickness="2.4"
                          StrokeLineCap="Round" StrokeJoin="Round"
                          Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="No completed packages yet" FontSize="16.5" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                <TextBlock Text="Once your queued downloads finish assembling and extracting, they will appear here with quick folder access."
                           FontSize="12.5" Foreground="#8B98AD" TextAlignment="Center" TextWrapping="Wrap" LineHeight="19"/>
            </StackPanel>
        </Border>

        <!-- 3B. Completed List -->
        <ScrollViewer Grid.Row="2" IsVisible="{Binding HasCompletedPackages}"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Packages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DownloadPackageViewModel">
                        <Border Background="#121824" BorderBrush="#1E2738" BorderThickness="1"
                                CornerRadius="10" Margin="0,0,0,8" Padding="14,12"
                                IsVisible="{Binding IsVisibleInCompleted}">
                            <Grid ColumnDefinitions="*,110,115,80">
                                <Grid Grid.Column="0" ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Border Grid.Column="0" Width="32" Height="32" Background="#112A22" BorderBrush="#1E4D3E" BorderThickness="1"
                                            CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Path Data="M 20,6 L 9,17 L 4,12" Stroke="#34D399" StrokeThickness="2.2"
                                              StrokeLineCap="Round" StrokeJoin="Round"
                                              Width="15" Height="15" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="#F8FAFC"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   ToolTip.Tip="{Binding Name}"/>
                                        <TextBlock Text="{Binding DestinationDirectory}" FontSize="11.5" Foreground="#64748B"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   ToolTip.Tip="{Binding DestinationDirectory}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Grid.Column="1" Text="{Binding FormattedTotalSize}"
                                           Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="13"
                                           VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,8,0"/>

                                <Border Grid.Column="2" Background="{Binding BadgeBackground}"
                                        BorderBrush="{Binding BadgeBorder}" BorderThickness="1"
                                        CornerRadius="12" Padding="11,3"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding BadgeForeground}"
                                               FontWeight="SemiBold" FontSize="11.5"/>
                                </Border>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Classes="icon-btn"
                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).OpenPackageFolderCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="Open Destination Folder">
                                        <Path Data="M 3,7 A 2,2 0 0 1 5,5 L 9,5 L 11,7 L 19,7 A 2,2 0 0 1 21,9 L 21,18 A 2,2 0 0 1 19,20 L 5,20 A 2,2 0 0 1 3,18 Z"
                                              Stroke="#34D399" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform"/>
                                    </Button>

                                    <Button Classes="icon-btn"
                                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RemovePackageCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="Remove from List">
                                        <Path Data="M 18,6 L 6,18 M 6,6 L 18,18"
                                              Stroke="#94A3B8" StrokeThickness="1.8" StrokeLineCap="Round"
                                              Width="11" Height="11" Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
