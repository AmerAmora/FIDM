<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetDownloader.Gui.ViewModels"
             x:Class="NetDownloader.Gui.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 1. Page Header -->
        <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,20">
            <TextBlock Text="Engine Settings" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC"/>
            <TextBlock Text="Configure parallel connection limits, storage paths, and post-download archive extraction"
                       FontSize="12.5" Foreground="#64748B"/>
        </StackPanel>

        <!-- 2. Settings Cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="*,*" Margin="0,0,0,16">
                <!-- Left Card: Download Engine & Concurrency -->
                <Border Grid.Column="0" Background="#121824" BorderBrush="#1E2738" BorderThickness="1"
                        CornerRadius="12" Padding="22,20" Margin="0,0,10,0" VerticalAlignment="Top">
                    <StackPanel Spacing="18">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="28" Height="28" CornerRadius="7" Background="#15233B">
                                <Path Data="M 13,2 L 3,14 L 12,14 L 11,22 L 21,10 L 12,10 Z"
                                      Fill="#38BDF8" Width="14" Height="14" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Transfer Engine &amp; Concurrency" FontSize="15.5" FontWeight="SemiBold"
                                       Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Height="1" Background="#1B2436"/>

                        <!-- Max Concurrent Packages -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="Concurrent Packages" Foreground="#E2E8F0" FontSize="13.5" FontWeight="Medium"/>
                                <TextBlock Text="Maximum packages downloading simultaneously" Foreground="#64748B" FontSize="11.5"/>
                            </StackPanel>
                            <NumericUpDown Grid.Column="1" Value="{Binding MaxConcurrentPackages}" Minimum="1" Maximum="10" Width="112"
                                           CornerRadius="7" Background="#0A0E16" BorderBrush="#1E2738" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Max Downloads Per Package -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="Files Per Package" Foreground="#E2E8F0" FontSize="13.5" FontWeight="Medium"/>
                                <TextBlock Text="Archive parts downloaded in parallel per package" Foreground="#64748B" FontSize="11.5"/>
                            </StackPanel>
                            <NumericUpDown Grid.Column="1" Value="{Binding MaxDownloadsPerPackage}" Minimum="1" Maximum="20" Width="112"
                                           CornerRadius="7" Background="#0A0E16" BorderBrush="#1E2738" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Chunks Per File -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="Segments (Chunks) Per File" Foreground="#E2E8F0" FontSize="13.5" FontWeight="Medium"/>
                                <TextBlock Text="Parallel HTTP range connections per file (1–32)" Foreground="#64748B" FontSize="11.5"/>
                            </StackPanel>
                            <NumericUpDown Grid.Column="1" Value="{Binding ChunksPerFile}" Minimum="1" Maximum="32" Width="112"
                                           CornerRadius="7" Background="#0A0E16" BorderBrush="#1E2738" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="#1B2436"/>

                        <!-- Global Speed Limit -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding IsSpeedLimitEnabled}" Content="Enable Global Bandwidth Cap"
                                          Foreground="#E2E8F0" FontSize="13.5" FontWeight="Medium"/>
                                <TextBlock Text="Throttle aggregate download rate across all connections" Foreground="#64748B" FontSize="11.5" Margin="28,0,0,0"/>
                            </StackPanel>
                            <NumericUpDown Grid.Column="1" Value="{Binding SpeedLimitMb}" Minimum="1" Maximum="1000" Width="120"
                                           IsEnabled="{Binding IsSpeedLimitEnabled}" CornerRadius="7"
                                           Background="#0A0E16" BorderBrush="#1E2738" Foreground="#F8FAFC"
                                           FormatString="{}{0} MB/s" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Right Column: Storage & Auto-Extractor -->
                <StackPanel Grid.Column="1" Spacing="16" Margin="10,0,0,0">
                    <!-- Storage Card -->
                    <Border Background="#121824" BorderBrush="#1E2738" BorderThickness="1"
                            CornerRadius="12" Padding="22,20">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="28" Height="28" CornerRadius="7" Background="#15233B">
                                    <Path Data="M 3,7 A 2,2 0 0 1 5,5 L 9,5 L 11,7 L 19,7 A 2,2 0 0 1 21,9 L 21,18 A 2,2 0 0 1 19,20 L 5,20 A 2,2 0 0 1 3,18 Z"
                                          Stroke="#60A5FA" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Storage &amp; Default Location" FontSize="15.5" FontWeight="SemiBold"
                                           Foreground="#F8FAFC" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Default folder where newly captured packages are saved" Foreground="#64748B" FontSize="12"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Classes="modern" Text="{Binding DefaultDownloadDirectory}"
                                         Height="36" FontSize="12.5" Padding="11,7" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Name="BrowseDefaultDirButton" Classes="toolbar"
                                        Padding="12,8" Margin="8,0,0,0" Click="OnBrowseDefaultDirClicked"
                                        ToolTip.Tip="Choose Folder">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Data="M 3,7 A 2,2 0 0 1 5,5 L 9,5 L 11,7 L 19,7 A 2,2 0 0 1 21,9 L 21,18 A 2,2 0 0 1 19,20 L 5,20 A 2,2 0 0 1 3,18 Z"
                                              Stroke="#93C5FD" StrokeThickness="1.7" Width="13" Height="13" Stretch="Uniform"/>
                                        <TextBlock Text="Browse" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Archive Auto-Extractor Card -->
                    <Border Background="#121824" BorderBrush="#1E2738" BorderThickness="1"
                            CornerRadius="12" Padding="22,20">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="28" Height="28" CornerRadius="7" Background="#122923">
                                    <Path Data="M 21,8 L 21,21 L 3,21 L 3,8 M 1,3 L 23,3 L 23,8 L 1,8 Z M 10,12 L 14,12"
                                          Stroke="#34D399" StrokeThickness="1.7" StrokeJoin="Round" Width="14" Height="14" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Archive Auto-Extractor" FontSize="15.5" FontWeight="SemiBold"
                                           Foreground="#F8FAFC" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Height="1" Background="#1B2436"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Auto-Extract Archives" Foreground="#E2E8F0" FontSize="13.5" FontWeight="Medium"/>
                                    <TextBlock Text="Automatically unpack RAR, 7z, and ZIP volumes when complete" Foreground="#64748B" FontSize="11.5"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoExtract}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Clean Up Archive Volumes" Foreground="#E2E8F0" FontSize="13.5" FontWeight="Medium"/>
                                    <TextBlock Text="Delete .partX.rar / .7z archive parts after successful extraction" Foreground="#64748B" FontSize="11.5"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DeleteArchiveAfterExtract}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- 3. Bottom Action Bar + Saved Confirmation Pill -->
        <Border Grid.Row="2" Background="#111723" BorderBrush="#1E2738" BorderThickness="1"
                CornerRadius="12" Padding="16,12">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="Changes take effect immediately across active and newly queued transfers."
                           Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>

                <Border Grid.Column="1" IsVisible="{Binding IsSaveStatusVisible}"
                        Background="#1F10B981" BorderBrush="#4D10B981" BorderThickness="1"
                        CornerRadius="10" Padding="12,5" Margin="0,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Data="M 20,6 L 9,17 L 4,12" Stroke="#34D399" StrokeThickness="2.2"
                              StrokeLineCap="Round" StrokeJoin="Round" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SaveStatusMessage}" Foreground="#34D399" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button Grid.Column="2" Classes="primary" Command="{Binding SaveSettingsCommand}" Padding="22,9">
                    <TextBlock Text="Save &amp; Apply Settings" FontSize="13" FontWeight="SemiBold"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
