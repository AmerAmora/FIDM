<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetDownloader.Gui.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#131722"/>
        <SolidColorBrush x:Key="ThemeCardBrush" Color="#1E232F"/>
        <SolidColorBrush x:Key="ThemeBorderBrush" Color="#262D3D"/>
        <SolidColorBrush x:Key="ThemeAccentBrush" Color="#2D8CFF"/>
        <SolidColorBrush x:Key="ThemeTextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeTextSecondary" Color="#8F9CAE"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!-- Custom Sidebar Button Style -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#8F9CAE"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1C222F"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- Custom Action Bar Button Style -->
        <Style Selector="Button.action">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1F2635"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Application.Styles>
</Application>
